{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Belhana",
  "version": "0.1.0",
  "identifier": "com.dawwar.online.allama.belhana",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "بالهنا — Belhana",
        "label": "main",
        "width": 430,
        "height": 860,
        "minWidth": 340,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8080 http://localhost:8080 http://10.0.2.2:8080 http://*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
