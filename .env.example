# API server
BELHANA_HOST=127.0.0.1
BELHANA_PORT=8080
BELHANA_DATABASE_URL=belhana.db
# IMPORTANT: replace with a long random secret in any shared deployment
BELHANA_JWT_SECRET=change-me

# Logging (optional)
RUST_LOG=info,sqlx=warn

# AI assistant (optional — app works without a provider key)
# BELHANA_GEMINI_API_KEY=
# BELHANA_GEMINI_MODEL=gemini-2.0-flash
# BELHANA_OPENAI_API_KEY=
# BELHANA_OPENAI_MODEL=gpt-4o-mini
# BELHANA_OPENAI_BASE_URL=https://api.openai.com/v1

# Maintenance worker
BELHANA_STALE_DAYS=30

# Web dev proxy target (apps/web/vite.config.js uses 8080 by default)
# BELHANA_API_BASE=http://127.0.0.1:8080
